{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cf-demo-vulnerable-app",
  "main": "src/entry.py",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["python_workers"],
  // Workers Logs is opt-in -- without this block, nothing is ingested into
  // Observability regardless of real traffic. head_sampling_rate: 1 logs
  // every request (fine at demo volume; would tune down for real prod load).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cf-demo-vulnerable-app-db",
      // Real database ID, created by Terraform (terraform/sites/vulnerable-app/d1.tf).
      // Not a secret -- same category as a zone/account ID.
      "database_id": "37ad01fe-1579-4931-9112-86de690163db"
    }
  ]
}
